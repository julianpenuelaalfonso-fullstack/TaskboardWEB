# Copia este archivo como .env y completa los valores.

# Desarrollo local: usa la External Database URL de Render
DATABASE_URL=postgresql://usuario:clave@host.render.com/taskboard_db
DB_SSL=true

# Origen permitido por CORS (en local, el servidor de Vite)
FRONTEND_URL=http://localhost:5173

# Clave para firmar las sesiones (JWT). Usa un texto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

PORT=3000
