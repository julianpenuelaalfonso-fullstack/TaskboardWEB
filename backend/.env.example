# Copia este archivo como .env y completa los valores.

# Desarrollo local: usa la External Database URL de Render
DATABASE_URL=postgresql://usuario:clave@host.render.com/taskboard_db
DB_SSL=true

# Origen permitido por CORS (en local, el servidor de Vite)
FRONTEND_URL=http://localhost:5173

# Clave para firmar las sesiones (JWT). Usa un texto largo y aleatorio.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

PORT=3000

# Correo con la API de Zoho Mail (sale por HTTPS, funciona en el plan gratis de Render).
# Si se dejan vacías, los correos solo se escriben en los logs.
# ZOHO_DC es la terminación de tu Zoho: com, eu, in, com.au, jp
# El refresh token se obtiene una vez con: node scripts/zoho-get-refresh-token.js
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Opcional: si se omite, se consulta automáticamente
ZOHO_ACCOUNT_ID=
# Debe ser el correo (o un alias) de la cuenta de Zoho que autorizó la app
MAIL_FROM=
