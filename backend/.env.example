# Copia este archivo a .env y ajusta los valores.

# Conexión a PostgreSQL (local: contenedor Docker taskboard-db)
DATABASE_URL=postgresql://taskboard:taskboard_local@127.0.0.1:15432/taskboard_v2
# Base usada por las pruebas automáticas
TEST_DATABASE_URL=postgresql://taskboard:taskboard_local@127.0.0.1:15432/taskboard_test
# true si el proveedor exige SSL (p. ej. Render); false en local
DB_SSL=false

# Secreto de Better Auth: mínimo 32 caracteres (genera uno con: openssl rand -base64 32)
BETTER_AUTH_SECRET=cambia-este-secreto-por-uno-de-32-caracteres-o-mas
# URL pública de la app (la usa Better Auth y los enlaces de correo)
APP_URL=http://localhost:5173

# Inicio de sesión con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envío de correos con Resend (opcional en local: sin clave se imprimen en consola; OBLIGATORIA con NODE_ENV=production)
RESEND_API_KEY=
EMAIL_FROM=TaskBoard <no-reply@taskboard.local>

# Número de proxies delante de la API (en Render empezar con 1 y verificar en el despliegue; ver README)
TRUST_PROXY_HOPS=0

# Diagnóstico temporal: registra req.ip y X-Forwarded-For de las primeras 20 peticiones (ver README)
# DEBUG_CLIENT_IP=1

# Puerto de la API
PORT=3002
